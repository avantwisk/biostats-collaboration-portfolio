C  <- 1   # illustration scale
mcse <- C / sqrt(ns)
df_mcse <- tibble(nsim = ns, mcse = mcse)
ggplot(df_mcse, aes(x = nsim, y = mcse)) +
geom_line(linewidth = 1.2, color = "#003366") +
geom_point(size = 2.2, color = "#003366") +
scale_x_continuous(trans = "log2", breaks = ns) +
